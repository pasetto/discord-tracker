{
  "name": "discord-tracker",
  "version": "1.0.0",
  "description": "Bot Discord para monitoramento de presença e atividade em canais de voz",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy-views",
    "copy-views": "node -e \"const fs=require('fs');const p=require('path');const s=p.join('src','dashboard','views');const d=p.join('dist','dashboard','views');fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).forEach(f=>fs.copyFileSync(p.join(s,f),p.join(d,f)));\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop discord-tracker",
    "pm2:restart": "pm2 restart discord-tracker"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": ["discord", "tracker", "presence", "voice", "mongodb"],
  "license": "MIT",
  "dependencies": {
    "@koa/router": "^13.1.0",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "koa": "^2.15.4",
    "koa-bodyparser": "^4.4.1",
    "koa-static": "^5.0.0",
    "mongoose": "^8.12.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa__router": "^12.0.4",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
