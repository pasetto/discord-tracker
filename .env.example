# =============================================================================
# Syntra — variáveis de INFRAESTRUTURA apenas
# =============================================================================
# Config de negócio (Discord bot, canais, guilds, API keys, timezone) → UI + banco
# Ver: docs/superpowers/specs/2026-06-20-pulsedesk-saas-design.md (seção 5.4 e 12.2)
# =============================================================================

# MongoDB
MONGODB_URI=mongodb://localhost:27017/discord-tracker

# Criptografia de secrets no banco (Discord token, client secret) — 32 bytes base64
# Gere com: npm run generate:encryption-key --workspace=backend
ENCRYPTION_KEY=

# Web Push (PWA)
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@syntra.app

# JWT
JWT_SECRET=altere_em_producao_minimo_32_caracteres

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Servidor HTTP
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost:4200
API_PUBLIC_URL=http://localhost:3000

# =============================================================================
# Bootstrap DEV opcional (somente NODE_ENV=development)
# =============================================================================
# Credenciais Discord NÃO vão em ENV em produção.
# Dev: cadastre via UI (/admin/discord) ou seed:
#   DEV_SEED_DISCORD=true npm run seed:discord-app
#   (lê backend/seed/discord-app.local.json — gitignored)
DEV_SEED_DISCORD=false

# =============================================================================
# REMOVIDO no SaaS — não usar (configurar via UI)
# =============================================================================
# DISCORD_TOKEN          → Super Admin /admin/discord
# DISCORD_CLIENT_ID      → idem
# DISCORD_CLIENT_SECRET  → idem
# DISCORD_GUILD_ID       → Tenant /settings/discord
# IGNORED_CHANNELS       → Manager /settings/channels
# AFK_CHANNEL_NAMES      → idem
# LUNCH_CHANNEL_NAMES    → idem
# API_KEYS               → Admin /settings/api-keys
# TIMEZONE               → Org settings
# APP_URL / CORS_ORIGIN  → Super Admin /admin/platform
