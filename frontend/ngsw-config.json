{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/images/**",
          "/*.(png|jpg|jpeg|gif|svg|webp|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "public-api",
      "urls": [
        "/api/v1/public/**",
        "/api/v1/pricing"
      ],
      "cacheConfig": {
        "maxSize": 20,
        "maxAge": "5m",
        "timeout": "10s",
        "strategy": "freshness"
      }
    }
  ]
}
