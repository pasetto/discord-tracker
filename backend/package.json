{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Syntra API + Discord bot",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "discord",
    "tracker",
    "presence",
    "voice",
    "mongodb",
    "syntra"
  ],
  "license": "MIT",
  "dependencies": {
    "@koa/router": "^13.1.0",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.3",
    "koa": "^2.15.4",
    "koa-bodyparser": "^4.4.1",
    "mongoose": "^8.12.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "supertest": "^7.2.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/koa__router": "^12.0.4",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/node": "^22.13.10",
    "@types/supertest": "^7.2.0",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
