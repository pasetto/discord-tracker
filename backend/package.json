{
  "name": "backend",
  "version": "1.2.1",
  "private": true,
  "description": "Syntra API + Discord bot",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsx scripts/generateBuildInfo.ts && tsc",
    "start": "node dist/index.js",
    "start:pm2": "pm2 start ecosystem.config.js",
    "dev": "tsx watch src/index.ts",
    "seed:plans": "tsx src/scripts/seedPlans.ts",
    "seed:discord-app": "tsx src/scripts/seedDiscordApp.ts",
    "backfill:session-scope": "tsx src/scripts/backfillSessionScope.ts",
    "backfill:session-legacy": "tsx src/scripts/backfillSessionLegacy.ts",
    "generate:encryption-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "discord",
    "tracker",
    "presence",
    "voice",
    "mongodb",
    "syntra"
  ],
  "license": "MIT",
  "dependencies": {
    "@koa/router": "^13.1.0",
    "@sentry/node": "^10.61.0",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.3",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.3",
    "koa": "^2.15.4",
    "koa-bodyparser": "^4.4.1",
    "koa-swagger-ui": "^1.1.3",
    "mongoose": "^8.12.1",
    "nodemailer": "^9.0.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "stripe": "^22.2.2",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.3.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/koa__router": "^12.0.4",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.6",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
