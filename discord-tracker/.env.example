# Discord
DISCORD_TOKEN=seu_token_aqui
DISCORD_GUILD_ID=id_do_servidor

# MongoDB
MONGODB_URI=mongodb://localhost:27017/discord-tracker

# Servidor HTTP
PORT=3000
HOST=0.0.0.0

# Canais ignorados (nomes ou IDs separados por vírgula)
# Exemplo: AFK,Almoço,123456789012345678
IGNORED_CHANNELS=AFK,Almoço

# Tipos de canal por nome (case-insensitive)
AFK_CHANNEL_NAMES=AFK,afk
LUNCH_CHANNEL_NAMES=Almoço,Almoco,Lunch

# Logs
LOG_LEVEL=info
NODE_ENV=development

# Autenticação API (uma ou mais chaves separadas por vírgula)
API_KEYS=sua_api_key_secreta_aqui

# Timezone para relatórios e agregações diárias
TIMEZONE=America/Sao_Paulo
