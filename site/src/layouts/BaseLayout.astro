---
/**
 * Layout base da landing marketing Syntra.
 * @prop {string} title - Título da página (SEO)
 * @prop {string} description - Meta description / OG
 */
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const appUrl = import.meta.env.PUBLIC_APP_URL || 'http://localhost:4200';
const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://syntra.app';

const {
  title = 'Syntra — Saiba quem sumiu no Discord do seu time',
  description = 'Analytics de colaboração no Discord para gestores de times remotos. Inatividade com contexto de calendário e PTO — sem ler mensagens nem gravar áudio.',
} = Astro.props;

const canonical = new URL('/', siteUrl).toString();
const ogImage = new URL('/og-stub.svg', siteUrl).toString();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1729" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Syntra" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,650;12..96,750&family=Public+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Analytics stub (soft-launch): substituir por Plausible / GA / PostHog -->
    <script is:inline define:vars={{ siteUrl }}>
      window.__SYNTRA_ANALYTICS__ = { provider: 'stub', siteUrl };
    </script>
  </head>
  <body data-app-url={appUrl}>
    <slot />
  </body>
</html>
