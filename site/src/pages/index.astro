---
/**
 * Landing marketing Syntra (Astro) — redesign B2B estrutura Sentry (SYN-119 / brief SYN-118).
 * CTA primário = Criar conta → app /signup.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { PRODUCT_SECTIONS } from '../content/product-sections';
import { FALLBACK_PRICING_PLANS } from '../scripts/pricing/public-pricing';

const appUrl = (import.meta.env.PUBLIC_APP_URL || 'http://localhost:4200').replace(/\/$/, '');
const signupUrl = `${appUrl}/signup`;
const loginUrl = `${appUrl}/signin`;
const homeUrl = import.meta.env.BASE_URL || '/';
const assetBase = homeUrl.replace(/\/?$/, '/');
const logoSrc = `${assetBase}images/logo/logo.svg`;

const tensions = [
  {
    title: 'Sinal tardio',
    body: 'Você só nota quando o atraso já virou retrabalho.',
  },
  {
    title: 'Sem contexto',
    body: 'Sumiu de verdade, ou está de PTO / fora da jornada?',
  },
  {
    title: 'Ação às cegas',
    body: 'Energia gasta no lugar errado, conversa difícil sem base.',
  },
];

const antiClaims = [
  {
    title: 'Não é timesheet legal',
    body: 'Não substitui ponto eletrônico nem compliance trabalhista.',
  },
  {
    title: 'Não é Jira',
    body: 'Não gerencia tickets, sprints ou entrega.',
  },
  {
    title: 'Não é spyware',
    body: 'Não armazena conteúdo de mensagens, áudio ou DMs.',
  },
];

const steps = [
  {
    n: '01',
    title: 'Conecte o servidor',
    body: 'Vincule o bot e escolha a guild. Defina canais de trabalho, AFK, almoço e ignorados na UI.',
  },
  {
    n: '02',
    title: 'Syntra lê sinais (só metadados)',
    body: 'Presença, tempo em voz colaborativa e atividade de texto — sem guardar o que foi dito.',
  },
  {
    n: '03',
    title: 'Aja cedo',
    body: 'Dashboard e relatórios de inatividade com calendário/PTO; push quando alguém some; time ao vivo quando precisar do “agora”.',
  },
];

const heroMembers = [
  { name: 'Ana', initials: 'A', tone: 'sky', status: 'collaborating', label: 'Colaborando' },
  { name: 'Bruno', initials: 'B', tone: 'emerald', status: 'missing', label: 'Sumiu' },
  { name: 'Camila', initials: 'C', tone: 'amber', status: 'pto', label: 'Em PTO' },
  { name: 'Diego', initials: 'D', tone: 'rose', status: 'missing', label: 'Sumiu' },
  { name: 'Elena', initials: 'E', tone: 'indigo', status: 'missing', label: 'Sumiu' },
] as const;

const faqs = [
  {
    q: 'Vocês leem as mensagens do time?',
    a: 'Não. Sinais de texto são metadados (ex.: atividade no canal). Conteúdo de mensagem, áudio e DMs não são armazenados.',
  },
  {
    q: 'Isso não vira vigilância?',
    a: 'O objetivo é visibilidade de colaboração e inatividade — com canais que você escolhe e contexto de calendário/PTO. Não é ferramenta para policiar o que as pessoas dizem.',
  },
  {
    q: 'Substitui Toggl / timesheet?',
    a: 'Substitui o “timer manual” como forma de ver colaboração do time. Não é timesheet legal nem ponto eletrônico.',
  },
  {
    q: 'E se a pessoa está de férias?',
    a: 'Ausências planejadas e calendário de trabalho entram no contexto para reduzir falso “sumiu”.',
  },
  {
    q: 'Quanto tempo para começar?',
    a: 'Criar conta, conectar o Discord e seguir o onboarding — a meta de produto é time-to-value em minutos, não em semanas.',
  },
  {
    q: 'Preciso de cartão para testar?',
    a: 'Não. Você cria a conta e entra em período de teste da organização sem cartão. O cartão só entra quando for assinar um plano via Stripe.',
  },
];
---

<BaseLayout>
  <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>

  <div class="landing-root">
    <header class="nav">
      <div class="wrap nav__inner">
        <a class="nav__brand" href={homeUrl} aria-label="Syntra — início">
          <img class="nav__logo" src={logoSrc} alt="" width="120" height="32" />
          <span class="sr-only">Syntra</span>
        </a>
        <nav class="nav__actions" aria-label="Ações da landing">
          <a class="nav__anchor" href="#produto">Produto</a>
          <a class="nav__anchor" href="#como-funciona">Como funciona</a>
          <a class="nav__anchor" href="#pricing">Planos</a>
          <a class="link-quiet nav__login" href={loginUrl}>Entrar</a>
          <a class="btn btn--primary" href={signupUrl} data-cta="nav">Criar conta</a>
        </nav>
      </div>
    </header>

    <main id="conteudo">
      <section class="hero" data-testid="landing-hero" aria-labelledby="hero-title">
        <div class="hero__atmosphere" aria-hidden="true"></div>
        <div class="wrap hero__inner">
          <div class="hero__copy">
            <img
              class="hero__logo"
              src={logoSrc}
              alt="Syntra"
              width="140"
              height="40"
              data-testid="landing-hero-logo"
              data-motion="hero-brand"
            />
            <h1 id="hero-title" data-motion="hero-headline">
              Quem sumiu no Discord do seu time — antes do atraso virar crise.
            </h1>
            <p class="hero__sub" data-motion="hero-sub">
              Radar de colaboração para gestores remotos. Você vê quem está no jogo e quem sumiu, com
              calendário e PTO no contexto. Sem ler mensagens. Sem gravar áudio.
            </p>
            <div class="hero__cta" data-motion="hero-ctas">
              <a class="btn btn--primary" href={signupUrl} data-cta="hero">Criar conta</a>
              <a class="link-quiet" href="#como-funciona">Ver como funciona</a>
            </div>
            <p class="hero__micro" data-motion="hero-trust">
              Sem cartão no teste. Setup em minutos. Só metadados.
            </p>
          </div>

          <aside
            class="hero-mock"
            data-testid="landing-hero-mock"
            data-mode="with"
            aria-label="Ilustração Sem Syntra versus Com Syntra"
          >
            <div class="hero-mock__chrome" data-motion="mock-chrome">
              <h2 class="hero-mock__title">Time agora</h2>
              <div
                class="hero-mock__toggle"
                role="radiogroup"
                aria-label="Comparar Sem Syntra e Com Syntra"
                data-testid="landing-hero-toggle"
              >
                <button
                  type="button"
                  role="radio"
                  aria-checked="false"
                  data-testid="landing-hero-toggle-without"
                >
                  Sem Syntra
                </button>
                <button
                  type="button"
                  role="radio"
                  aria-checked="true"
                  class="is-active"
                  data-testid="landing-hero-toggle-with"
                >
                  Com Syntra
                </button>
              </div>
            </div>

            <div class="hero-mock__body" data-motion="mock-body" data-mode="with">
              <p class="hero-mock__headline" data-testid="landing-hero-mock-headline">
                Três pessoas sumiram da colaboração hoje.
              </p>
              <p class="hero-mock__support" data-testid="landing-hero-mock-support" hidden></p>
              <ul class="hero-mock__members" data-testid="landing-hero-mock-members">
                {
                  heroMembers.map((member) => (
                    <li class="hero-mock__member">
                      <div class="hero-mock__person">
                        <span
                          class={`hero-mock__avatar hero-mock__avatar--${member.tone}`}
                          aria-hidden="true"
                        >
                          {member.initials}
                        </span>
                        <span class="hero-mock__name">{member.name}</span>
                      </div>
                      <span
                        class={`hero-mock__chip hero-mock__chip--${member.status}`}
                        data-status={member.status}
                      >
                        {member.label}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>

            <p class="hero-mock__footnote">Ilustração. Não é dado do seu servidor. Só metadados.</p>
          </aside>
        </div>
      </section>

      <section
        class="section problem"
        data-testid="landing-problem"
        aria-labelledby="problem-title"
      >
        <div class="wrap">
          <h2 id="problem-title" data-motion="reveal-heading">
            No Discord remoto, o sumiço não avisa.
          </h2>
          <p class="section__lead" data-motion="reveal-lead">
            O servidor está cheio de gente “online”. Depois um entregável atrasa, o clima esfria, ou
            alguém já pediu demissão em silêncio. Você descobre tarde porque o Discord não tem
            radar de colaboração: presença diluída, canais misturados, PTO longe da cabeça.
          </p>
          <dl class="tension-list">
            {
              tensions.map((item) => (
                <div class="tension-list__item" data-motion="reveal-child">
                  <dt>{item.title}</dt>
                  <dd>{item.body}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <section
        class="section product"
        id="produto"
        data-testid="landing-product"
        aria-labelledby="product-title"
      >
        <div class="wrap">
          <h2 id="product-title" data-motion="reveal-heading">Produto para quem gerencia o Discord</h2>
          <p class="section__lead" data-motion="reveal-lead">
            Cinco leituras distintas — inatividade, metas, calendário, sinais e gamificação — sem
            misturar com timesheet ou leitura de mensagens.
          </p>
          <div class="product__stack">
            {
              PRODUCT_SECTIONS.map((item, index) => (
                <article
                  class:list={['product-block', index % 2 === 1 && 'product-block--alt']}
                  id={item.id}
                  data-motion="reveal-child"
                >
                  <div class="product-block__copy">
                    <h3>{item.title}</h3>
                    <p>{item.lead}</p>
                    <ul>
                      {item.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  </div>
                  <div class="product-block__visual" aria-hidden="true">
                    {item.visual === 'missing-strip' ? (
                      <ul class="viz-strip">
                        <li>
                          <span>Bruno</span>
                          <span class="hero-mock__chip hero-mock__chip--missing" data-status="missing">
                            Sumiu
                          </span>
                        </li>
                        <li>
                          <span>Diego</span>
                          <span class="hero-mock__chip hero-mock__chip--missing" data-status="missing">
                            Sumiu
                          </span>
                        </li>
                        <li>
                          <span>Elena</span>
                          <span class="hero-mock__chip hero-mock__chip--missing" data-status="missing">
                            Sumiu
                          </span>
                        </li>
                      </ul>
                    ) : null}
                    {item.visual === 'goal-bar' ? (
                      <div class="viz-goal">
                        <div class="viz-goal__label">
                          <span>Ana · colaboração</span>
                          <span>72%</span>
                        </div>
                        <div class="viz-goal__track">
                          <span class="viz-goal__fill" style="width: 72%"></span>
                        </div>
                      </div>
                    ) : null}
                    {item.visual === 'pto-chip' ? (
                      <div class="viz-pto">
                        <span class="hero-mock__chip hero-mock__chip--pto">Em PTO</span>
                        <span class="viz-pto__note">fora do falso “sumiu”</span>
                      </div>
                    ) : null}
                    {item.visual === 'metadata' ? (
                      <div class="viz-meta">
                        <p class="viz-meta__eq">metadado ≠ mensagem</p>
                        <p class="viz-meta__note">atividade no canal · conteúdo fora</p>
                      </div>
                    ) : null}
                    {item.visual === 'team-plus' ? (
                      <div class="viz-team">
                        <p class="viz-team__badge">plano Team+</p>
                        <p class="viz-team__note">ranking e conquistas quando o plano e as settings permitem</p>
                      </div>
                    ) : null}
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section anti" aria-labelledby="anti-title">
        <div class="wrap">
          <h2 id="anti-title">Visibilidade de colaboração. Sem vigilância de conteúdo.</h2>
          <p class="section__lead">
            Syntra existe para responder “quem está colaborando — e quem sumiu?”. Ponto.
          </p>
          <ul class="anti-list">
            {
              antiClaims.map((item) => (
                <li>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </li>
              ))
            }
          </ul>
          <p class="anti__close">Você configura quais canais entram no radar. O resto fica fora.</p>
        </div>
      </section>

      <section
        class="section how"
        id="como-funciona"
        data-testid="landing-how"
        aria-labelledby="how-title"
      >
        <div class="wrap">
          <h2 id="how-title" data-motion="reveal-heading">Do Discord ao alerta — em três passos.</h2>
          <p class="section__lead" data-motion="reveal-lead">
            Onboarding guiado para ir do signup à primeira visão de colaboração.
          </p>
          <ol class="steps">
            {
              steps.map((step) => (
                <li data-motion="reveal-child">
                  <span class="steps__n" aria-hidden="true">
                    {step.n}
                  </span>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section
        class="section privacy"
        data-testid="landing-privacy"
        aria-labelledby="privacy-title"
      >
        <div class="wrap privacy__grid" data-motion="reveal-shell">
          <div>
            <h2 id="privacy-title" data-motion="reveal-heading">
              Privacidade não é rodapé — é o produto.
            </h2>
            <p class="section__lead" data-motion="reveal-lead">
              Textos e chamadas importam para o trabalho. Syntra <strong>não</strong> precisa do
              conteúdo para te avisar quem sumiu. Usa metadados mínimos, escopo de canais sob seu
              controle, e portal do colaborador para transparência sobre os próprios dados.
            </p>
          </div>
          <ul class="privacy__bullets">
            <li data-motion="reveal-child">Sem conteúdo de mensagem, áudio ou DM.</li>
            <li data-motion="reveal-child">Escopo de canais definido por você.</li>
            <li data-motion="reveal-child">
              Feito para confiança do time — não para surpresa na sexta.
            </li>
          </ul>
        </div>
      </section>

      <section class="section pricing" id="pricing" aria-labelledby="pricing-title">
        <div class="wrap">
          <header class="pricing__header">
            <h2 id="pricing-title" data-motion="reveal-heading">Planos em BRL</h2>
            <p class="section__lead" data-motion="reveal-lead">
              Preços e limites vêm da API pública. Escolha o plano, crie a conta, teste sem cartão.
            </p>
          </header>
          <p
            class="pricing__error"
            data-testid="landing-pricing-error"
            hidden
            data-pricing-error
          >
            Não deu para carregar os planos agora. Você ainda pode criar a conta e ver os planos
            depois.
          </p>
          <div class="pricing__grid" data-pricing-grid>
            {
              FALLBACK_PRICING_PLANS.map((plan) => (
                <article
                  class:list={['pricing__card', plan.featured && 'pricing__card--featured']}
                  data-motion="reveal-child"
                  data-plan-slug={plan.slug}
                >
                  {plan.featured ? <p class="pricing__badge">Mais popular</p> : null}
                  <p class="pricing__name">{plan.name}</p>
                  <p class="pricing__price">{plan.priceBrlMonthly}</p>
                  <p class="pricing__interval">por mês</p>
                  <p class="pricing__desc">{plan.description}</p>
                  <p class="pricing__limit">
                    Até {plan.maxTrackedMembers} membros rastreados.
                  </p>
                  <ul class="pricing__highlights">
                    {plan.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                  <a class="btn btn--primary pricing__cta" href={signupUrl} data-cta="pricing">
                    Criar conta
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section faq" data-testid="landing-faq" aria-labelledby="faq-title">
        <div class="wrap">
          <h2 id="faq-title" data-motion="reveal-heading">Perguntas frequentes</h2>
          <p class="section__lead" data-motion="reveal-lead">
            Respostas curtas sobre privacidade, timesheet e time-to-value.
          </p>
          <div class="faq__list">
            {
              faqs.map((item) => (
                <details data-motion="reveal-child">
                  <summary>{item.q}</summary>
                  <p>{item.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <section
        class="section cta"
        data-testid="landing-final-cta"
        aria-labelledby="cta-title"
      >
        <div class="wrap cta__inner" data-motion="reveal-shell">
          <h2 id="cta-title" data-motion="reveal-heading">
            Pare de descobrir sumiço tarde demais.
          </h2>
          <p data-motion="reveal-lead">
            Crie a conta e veja quem está colaborando, e quem sumiu, no Discord do seu time.
          </p>
          <a class="btn btn--ink" href={signupUrl} data-cta="footer" data-motion="reveal-child">
            Criar conta
          </a>
          <p class="cta__trust" data-motion="reveal-child">
            Sem cartão no teste. Só metadados. Sem ler mensagens.
          </p>
        </div>
      </section>

      <section class="section legal-stub" id="privacidade-stub" aria-labelledby="privacy-stub-title">
        <div class="wrap">
          <h2 id="privacy-stub-title">Privacidade (rascunho)</h2>
          <p class="section__lead">
            Syntra processa metadados de colaboração no Discord (presença, tempo em voz, atividade
            de texto) no escopo de canais que você configura. Não armazenamos conteúdo de mensagens,
            áudio ou DMs. Política completa em revisão.
          </p>
        </div>
      </section>
      <section
        class="section legal-stub legal-stub--alt"
        id="termos-stub"
        aria-labelledby="terms-stub-title"
      >
        <div class="wrap">
          <h2 id="terms-stub-title">Termos (rascunho)</h2>
          <p class="section__lead">
            O uso do Syntra está sujeito a termos de serviço a publicar antes do lançamento público.
            Em soft-launch, o acesso é de avaliação — não é timesheet legal nem substituto de
            ferramentas de projetos.
          </p>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap footer__inner">
        <div>
          <strong>Syntra</strong>
          <span> · Colaboração no Discord</span>
          <p class="footer__teaser">Planos em BRL</p>
        </div>
        <nav class="footer__links" aria-label="Legal">
          <a href="#privacidade-stub">Privacidade</a>
          <a href="#termos-stub">Termos</a>
          <a href="mailto:contato@syntra.app">Contato</a>
        </nav>
        <p class="footer__copy">© {new Date().getFullYear()} Syntra</p>
      </div>
    </footer>
  </div>

  <script>
    import '../scripts/motion/boot.ts';
    import '../components/hero-live-mock.ts';
    import '../scripts/pricing/boot.ts';
  </script>
</BaseLayout>

<style is:global>
  /* global: hero-mock / pricing cards are re-rendered by client scripts */
  .landing-root {
    --motion-duration-instant: 120ms;
    --motion-duration-fast: 180ms;
    --motion-duration-enter: 280ms;
    --motion-ease-out: cubic-bezier(0.25, 1, 0.5, 1);
    min-height: 100svh;
    background: var(--paper);
  }

  .landing-root.has-motion [data-motion='hero-brand'],
  .landing-root.has-motion [data-motion='hero-headline'],
  .landing-root.has-motion [data-motion='hero-sub'],
  .landing-root.has-motion [data-motion='hero-ctas'],
  .landing-root.has-motion [data-motion='hero-trust'],
  .landing-root.has-motion [data-testid='landing-hero-mock'],
  .landing-root.has-motion [data-motion='mock-chrome'],
  .landing-root.has-motion [data-testid='landing-hero-mock-members'] li,
  .landing-root.has-motion [data-motion='reveal-heading'],
  .landing-root.has-motion [data-motion='reveal-lead'],
  .landing-root.has-motion [data-motion='reveal-child'],
  .landing-root.has-motion [data-motion='reveal-shell'] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .landing-root,
    .landing-root * {
      transition: none !important;
      animation: none !important;
    }

    .landing-root.has-motion [data-motion='hero-brand'],
    .landing-root.has-motion [data-motion='hero-headline'],
    .landing-root.has-motion [data-motion='hero-sub'],
    .landing-root.has-motion [data-motion='hero-ctas'],
    .landing-root.has-motion [data-motion='hero-trust'],
    .landing-root.has-motion [data-testid='landing-hero-mock'],
    .landing-root.has-motion [data-motion='mock-chrome'],
    .landing-root.has-motion [data-testid='landing-hero-mock-members'] li,
    .landing-root.has-motion [data-motion='reveal-heading'],
    .landing-root.has-motion [data-motion='reveal-lead'],
    .landing-root.has-motion [data-motion='reveal-child'],
    .landing-root.has-motion [data-motion='reveal-shell'] {
      opacity: 1 !important;
      transform: none !important;
    }
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    background: var(--signal);
    color: var(--ink);
    text-decoration: none;
    border-radius: var(--radius);
  }

  .skip-link:focus {
    top: 1rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    padding-block: 0.85rem;
    border-bottom: 1px solid oklch(0.88 0.012 250 / 0.8);
    background: oklch(0.985 0.004 250 / 0.9);
    backdrop-filter: blur(10px);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .nav__logo {
    height: 2rem;
    width: auto;
  }

  .nav__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem 1rem;
  }

  .nav__anchor {
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .nav__anchor:hover {
    color: var(--ink);
  }

  @media (max-width: 720px) {
